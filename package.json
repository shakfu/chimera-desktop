{
  "name": "chimera-desktop",
  "version": "0.2.0",
  "description": "Tauri showcase desktop app for chimera (https://github.com/shakfu/chimera).",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "build-pwa-assets": "pwa-assets-generator --root . --config pwa-assets.config.ts && pwa-assets-generator --root . --config pwa-assets-dark.config.ts && node scripts/make-icons-circular.js"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.0",
    "@tauri-apps/plugin-http": "2.5.9",
    "@tauri-apps/plugin-opener": "2.5.4"
  },
  "devDependencies": {
    "@internationalized/date": "3.12.2",
    "@lucide/svelte": "1.46.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.2",
    "@sveltejs/vite-plugin-svelte": "6.2.1",
    "@tailwindcss/forms": "0.5.10",
    "@tailwindcss/typography": "0.5.16",
    "@tailwindcss/vite": "4.1.11",
    "@tauri-apps/cli": "2.11.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@types/node": "24.13.0",
    "@vite-pwa/assets-generator": "1.0.2",
    "@vite-pwa/sveltekit": "1.1.0",
    "bits-ui": "2.18.1",
    "clsx": "2.1.1",
    "dexie": "4.4.3",
    "dompurify": "3.4.13",
    "fflate": "0.8.3",
    "highlight.js": "11.11.1",
    "jsdom": "^29.1.1",
    "mdast": "3.0.0",
    "mdsvex": "0.12.7",
    "mermaid": "11.15.0",
    "mode-watcher": "1.1.0",
    "pdfjs-dist": "5.4.54",
    "rehype-highlight": "7.0.2",
    "rehype-katex": "7.0.1",
    "rehype-stringify": "10.0.1",
    "remark": "15.0.1",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-html": "16.0.1",
    "remark-math": "6.0.0",
    "remark-rehype": "11.1.2",
    "sass": "1.100.0",
    "svelte": "5.56.1",
    "svelte-check": "4.6.0",
    "svelte-sonner": "1.1.1",
    "tailwind-merge": "3.6.0",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.0",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "uuid": "13.0.2",
    "vaul-svelte": "1.0.0-next.7",
    "vite": "7.3.6",
    "vite-plugin-devtools-json": "0.2.1",
    "vitest": "4.1.10",
    "workbox-window": "7.4.1"
  },
  "overrides": {
    "cookie": "1.1.1",
